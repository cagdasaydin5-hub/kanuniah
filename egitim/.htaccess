Options -Indexes
DirectoryIndex index.php
# Sayfa kaynakları yalnızca index.php üzerinden, giriş yapılınca verilir
<FilesMatch "^(icerik|giris|cerceve|sayfa-[a-z0-9-]+)\.html$">
  Require all denied
</FilesMatch>
# ortak.php ve *-oku.php yalnızca diğer PHP dosyalarınca kullanılır
<FilesMatch "^(ortak|akademik-oku|calisma-oku|sunum-oku)\.php$">
  Require all denied
</FilesMatch>
